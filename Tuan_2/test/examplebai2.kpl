PROGRAM Test; (* Test các tính năng mới *)

// Đây là comment dòng - sẽ bỏ qua đến cuối dòng
VAR
  name : STRING;  // Kiểu dữ liệu STRING mới
  data : BYTES;   // Kiểu dữ liệu BYTES mới
  x : INTEGER;
  y : INTEGER;
  result : INTEGER;

BEGIN
  // Test phép toán MOD (%)
  x := 10;
  y := 3;
  result := x % y;  // result = 1

  // Test phép toán POWER (**)
  x := 2;
  y := 10;
  result := x ** y;  // result = 1024 (2^10)

  // Test cấu trúc REPEAT-UNTIL
  x := 0;
  REPEAT
    x := x + 1;
    CALL WriteI(x)
  UNTIL x >= 10;

  // Comment dòng không ảnh hưởng đến code
  result := (5 ** 2) % 3;  // (25) % 3 = 1

END. (* Kết thúc chương trình *)

// Comment dòng ở cuối file